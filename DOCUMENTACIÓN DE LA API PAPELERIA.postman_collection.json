									"pm.sendRequest(miUrl, function(err, response) {",
									" var json = response.json();",
									"const array = [];",
									"for(let i in json) {",
									"    array.push([i, json[i]]);",
									"} ;",
									" const clientes =array[0][1].clientes;",
									" const rutasClientes = [];",
									" for (let i in clientes) {",
									"    rutasClientes.push(clientes[i]._links.self.href);",
									" }",
									"pm.collectionVariables.set(\"clienteRandom\", rutasClientes[Math.floor(Math.random()*rutasClientes.length)]);",
									"});",
									""
								],
